# Worship Viewer backend — copy to `.env` (or `.env.local`) next to this file.
# `Settings::from_env` loads those files automatically; variables already in the
# process environment take precedence. Names match `src/settings.rs` (via `envy`).

# --- HTTP ---
HOST=127.0.0.1
PORT=8080

# --- Session cookie ---
POST_LOGIN_PATH=/
COOKIE_NAME=sso_session
COOKIE_SECURE=false
SESSION_TTL_SECONDS=31536000

# --- OTP email ---
OTP_TTL_SECONDS=300
OTP_PEPPER=changeme
OTP_MAX_ATTEMPTS=5
# OTP_ALLOW_SELF_SIGNUP=true
# WORSHIP_OTP_ALLOW_SELF_SIGNUP=true

# --- Gmail SMTP (required to send OTP mail) ---
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# --- OIDC (Google) ---
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
# OIDC_SCOPES=openid,profile,email

# --- Database ---
DB_ADDRESS=mem://
DB_NAMESPACE=main
DB_DATABASE=main
# DB_USERNAME=app
# DB_PASSWORD=app
DB_MIGRATION_PATH=db-migrations

# --- Optional local demodata (never enable in production) ---
# DEMODATA=generic

# --- Static assets & uploads ---
STATIC_DIR=static
BLOB_DIR=blobs
BLOB_UPLOAD_MAX_BYTES=20971520
# AVATAR_UPLOAD_MAX_BYTES=2097152

# --- Media asset staging/final storage ---
# MEDIA_STAGING_DIR=media-staging
# MEDIA_FINAL_DIR=media-assets
# MEDIA_VIDEO_UPLOAD_MAX_BYTES=2147483648
# MEDIA_AUDIO_UPLOAD_MAX_BYTES=524288000
# MEDIA_PDF_UPLOAD_MAX_BYTES=104857600
# MEDIA_IMAGE_UPLOAD_MAX_BYTES=26214400
# MEDIA_DECK_PROCESSING_TIMEOUT_SECONDS=3600
# MEDIA_DECK_MAX_PAGES=500
# MEDIA_STAGING_MAX_AGE_SECONDS=86400
# MEDIA_RECONCILIATION_INTERVAL_SECONDS=3600

# --- Rate limits (per client IP) ---
AUTH_RATE_LIMIT_RPS=1
AUTH_RATE_LIMIT_BURST=5
API_RATE_LIMIT_RPS=50
API_RATE_LIMIT_BURST=200

# --- Local dev helpers (never enable in production) ---
# INITIAL_ADMIN_USER_EMAIL=admin@example.com
# INITIAL_ADMIN_USER_TEST_SESSION=true

# --- Production / logging ---
# WORSHIP_PRODUCTION=true
# RUST_ENV=production
# RUST_LOG=info
# LOG_FORMAT=json

# --- OpenAPI metadata (optional) ---
# OPENAPI_CONTACT_EMAIL=
# OPENAPI_IMPRINT_URL=

# --- Build metadata (CI / Docker sets this for GET /api/v1/about) ---
# GIT_COMMIT_SHA=

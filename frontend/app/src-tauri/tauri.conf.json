{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worship Viewer",
  "version": "../package.json",
  "identifier": "com.worshipviewer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "https://app.worshipviewer.com"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worship Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["default", "presentation"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb", "appimage", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Worship library for your team",
    "longDescription": "Manage songs and lead worship with Worship Viewer.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["worshipviewer"]
      }
    }
  }
}

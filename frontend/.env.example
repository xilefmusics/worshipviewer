# Worship Viewer frontend — copy to `.env` (or `.env.local`) next to this file.
# `pnpm dev` loads those files via scripts/with-env.mjs; variables already in the
# process environment take precedence.

# Vite dev-server listen address (optional; Vite defaults if unset)
# HOST=127.0.0.1
PORT=5173

# Backend the Vite proxy forwards /api and /auth to
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
